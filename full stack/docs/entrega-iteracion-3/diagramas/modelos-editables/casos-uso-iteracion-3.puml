@startuml
left to right direction
actor Operador
actor Administrador as Admin
Admin --|> Operador
rectangle "Autos Colombia — Gestión de Parqueadero" {
 usecase "Consultar obligaciones" as U1
 usecase "Generar obligaciones de contrato" as U6
 usecase "Registrar pago completo manual" as U2
 usecase "Consultar historial de pagos" as U3
 usecase "Consultar comprobante interno" as U7
 usecase "Anular pago con motivo" as U4
 usecase "Consultar resumen de deuda" as U5
}
Operador --> U1
Operador --> U6
Operador --> U2
Operador --> U3
Operador --> U7
Operador --> U5
Admin --> U4
note bottom of U2
Transferencia se registra manualmente. Sin confirmación bancaria.
Comprobante interno, no factura electrónica.
end note
@enduml
