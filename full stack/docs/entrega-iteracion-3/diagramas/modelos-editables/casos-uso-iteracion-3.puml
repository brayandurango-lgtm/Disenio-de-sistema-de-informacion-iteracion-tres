@startuml
left to right direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontColor #242238
skinparam shadowing false
 skinparam dpi 180
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F5F1FF
  BorderColor #7653A6
  ArrowColor #55436F
}
skinparam actorStyle stickman

title Gestión de pagos de mensualidades

actor Operador as Op
actor Administrador as Admin
Admin --|> Op

rectangle "Sistema de gestión del parqueadero" {
  usecase "Consultar obligaciones\ny mensualidades" as UC1
  usecase "Generar obligaciones\ndel contrato" as UC2
  usecase "Registrar pago completo\n(efectivo o transferencia)" as UC3
  usecase "Consultar historial\nde pagos" as UC4
  usecase "Consultar detalle y\ncomprobante interno" as UC5
  usecase "Consultar resumen\nde deuda" as UC6
  usecase "Anular pago\ncon motivo" as UC7
}

Op -- UC1
Op -- UC2
Op -- UC3
Op -- UC4
Op -- UC5
Op -- UC6
Admin -- UC7

note bottom of UC3
La transferencia se registra manualmente.
No hay confirmación bancaria automática.
El comprobante es interno; no es factura electrónica.
end note

note bottom of Op
Precondición: iniciar sesión con una cuenta activa.
El cliente del parqueadero es un dato del sistema,
no un actor autenticado.
end note
@enduml
