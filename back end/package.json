{
  "name": "autos-colombia-backend",
  "version": "1.0.0",
  "description": "Backend API del parqueadero Autos Colombia (iteraciones 1-3)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "create-admin": "node src/scripts/create-admin.js",
