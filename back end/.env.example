# ==========================================================================
# Autos Colombia - Backend. Copie este archivo como ".env" y complete los
# valores. NUNCA suba .env al repositorio ni comparta las credenciales.
# ==========================================================================

# --- Base de datos principal de la aplicación ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_aplicacion
DB_PASSWORD=CAMBIAR
DB_NAME=Disenio_de_sistema_de_informacion_iteracion_tres
# Tamaño del pool de conexiones mysql2
DB_POOL_SIZE=10

# --- Servidor HTTP ---
PORT=3000
# Entorno: development | production
NODE_ENV=development

# --- Autenticación (JWT Bearer) ---
# Genere un secreto largo y aleatorio, p.ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CAMBIAR_POR_SECRETO_LARGO_ALEATORIO
# Tiempo de vida del token (formato jsonwebtoken: '8h', '30m', '7d')
JWT_EXPIRES_IN=8h

# --- CORS ---
# Orígenes permitidos separados por coma. Vacío = sin CORS (solo mismo origen).
# Isabella debe agregar aquí el origen real de su frontend local, p.ej.:
# CORS_ORIGIN=http://localhost:5173
CORS_ORIGIN=

# --- Protección de login (intentos por IP+usuario en memoria) ---
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MS=900000

# ==========================================================================
# PRUEBAS (solo base separada de pruebas; NUNCA la principal)
# Las pruebas de integración usan un archivo local separado .env.test (no
# versionado) y la base exacta ..._test. Actualmente la suite backend ejecuta
# resetDb() y elimina datos de todas las tablas de esa base; NO la ejecute
# hasta disponer de una base descartable y una estrategia de aislamiento.
# El archivo .env.test y sus credenciales deben prepararse localmente; no
# incluya valores reales en este ejemplo ni publique el archivo local.
# ==========================================================================
